# Chave do Google AI Studio (https://aistudio.google.com/apikey) — usada para vozes e, por padrão, roteiros
GEMINI_API_KEY=

# Roteirista: gemini (padrão, mesma chave) ou claude (precisa ANTHROPIC_API_KEY; costuma escrever melhor)
SCRIPT_PROVIDER=gemini
# Modelo do roteiro: vazio usa o padrão do código (src/roteiro.js: hoje gemini-3.5-flash, ou claude-sonnet-5-5 com SCRIPT_PROVIDER=claude)
SCRIPT_MODEL=
ANTHROPIC_API_KEY=

# Vozes: gemini ou nenhum (silêncio, para testar sem gastar)
TTS_PROVIDER=gemini
# Modelo de voz: vazio usa o padrão do código (src/tts.js: hoje gemini-3.8-flash-tts)
TTS_MODEL=

# Aviso quando um vídeo fica pronto ou dá erro (ex.: webhook do n8n que manda para o Slack/WhatsApp/Drive)
WEBHOOK_URL=

# Render: resolução interna (sai sempre em 1080x1920) e quadros por segundo
RENDER_RES=720x1280
FPS=30
